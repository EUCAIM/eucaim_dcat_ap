<https://cancerimage.eu/ontology/EUCAIM#DatasetShape/dcat:contactPoint> sh:path dcat:contactPoint;
  sh:name "Contact Point"@en;
  sh:description "Contact information of the individual/managing organization of the Dataset for sending comments about the Dataset."@en;
