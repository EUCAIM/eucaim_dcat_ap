<https://cancerimage.eu/ontology/EUCAIM#DatasetShape/dct:creator> sh:path dct:creator;
  sh:name "Creator"@en;
  sh:description "An entity responsible for producing the dataset."@en;
  sh:node eucaim:AgentShape;
  dash:viewer dash:DetailsViewer;
  dash:editor dash:BlankNodeEditor .

<https://cancerimage.eu/ontology/EUCAIM#DatasetShape/dcat:spatialResolutionInMeters>
  sh:path dcat:spatialResolutionInMeters;
  sh:name "Spatial Resolution"@en;
  sh:description "The minimum spatial separation resolvable in a dataset, measured in meters."@en;
  sh:maxCount 1;
  sh:nodeKind sh:Literal;
  sh:datatype xsd:decimal;
  dash:viewer dash:LiteralViewer;
  dash:editor dash:TextFieldEditor .

