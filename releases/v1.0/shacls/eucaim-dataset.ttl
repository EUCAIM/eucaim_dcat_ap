  sh:path healthdcatap:healthCategory;
  sh:name "Health Category"@en;
  sh:description "The health category to which this dataset belongs as described in the Commission Regulation on the European Health Data Space laying down a list of categories of electronic data for secondary use, Art.51."@en;
  sh:minCount 1;
  sh:nodeKind sh:IRI;
  dash:viewer dash:URIViewer;
  dash:editor dash:URIEditor .

<https://cancerimage.eu/ontology/EUCAIM#DatasetShape/healthdcatap:healthTheme> sh:path
