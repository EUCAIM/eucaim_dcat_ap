<https://cancerimage.eu/ontology/EUCAIM#DatasetShape/eucaim:collectionMethod> sh:path
    eucaim:collectionMethod;
  sh:name "Collection Method"@en;
  sh:description "This attribute defines the scope of data aggregation within the dataset. It specifies how data records are organized based on different criteria, allowing users to understand the context in which the data was collected."@en;
