@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix duo: <http://purl.obolibrary.org/obo/> .
@prefix eucaim-duc: <https://eucaim.github.io/eucaim_dcat_ap/releases/controlled-vocabularies/data-use-conditions/> .

eucaim-duc:
    a skos:ConceptScheme ;
    dct:title "EUCAIM Data Use Conditions"@en ;
    dct:description "Controlled vocabulary of data-use permissions and modifiers used to describe rights and reuse conditions for EUCAIM resources. The concepts are aligned with the Data Use Ontology (DUO)."@en ;
    skos:prefLabel "EUCAIM Data Use Conditions"@en .

eucaim-duc:DISEASE_SPECIFIC_RESEARCH
    a skos:Concept, dct:RightsStatement ;
    skos:inScheme eucaim-duc: ;
    skos:prefLabel "Disease specific research"@en ;
    skos:notation "DUO_0000007" ;
    skos:exactMatch duo:DUO_0000007 .

eucaim-duc:GENERAL_RESEARCH_USE
    a skos:Concept, dct:RightsStatement ;
    skos:inScheme eucaim-duc: ;
    skos:prefLabel "General research use"@en ;
    skos:notation "DUO_0000042" ;
    skos:exactMatch duo:DUO_0000042 .

